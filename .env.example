# Secrets for src/wp-config.php. Never commit the real file.
#
# Server:  /home/siteuser/.env  (outside the docroot, chmod 600, owned by the site user)
# Local:   .env in the repository root (copy this file and fill it in)
# Override the location with the MYSITE_ENV_FILE environment variable.
#
# Format: KEY=value, one per line. Everything after the first `=` is the value
# (one pair of surrounding quotes is stripped). No inline comments: values may
# contain # ' " $ and =. Every key below is required except WP_ENV.

# With Docker: DB_HOST=db, DB_NAME/DB_USER/DB_PASSWORD=wordpress (the fixed values in docker-compose.yml).
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=

# Authentication keys and salts. Generate a fresh set per environment:
# https://api.wordpress.org/secret-key/1.1/salt/
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=

# Optional. `local` defines WP_ENVIRONMENT_TYPE=local and turns on WP_DEBUG and
# WP_DEBUG_LOG (display stays off). Leave it empty on the server.
WP_ENV=
