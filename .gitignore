# Composer-installed WordPress (the webroot) and PHP dependencies. Both are
# generated by `composer install`; never edit or commit them.
/wordpress/
/vendor/

# Credentials for private Composer repositories. CI writes this from a secret.
/auth.json

# Translation downloader lock: it only makes sense when the downloaded files are
# committed. Here wordpress/ is rebuilt on every deploy, and with a lock present
# the plugin would skip the download and leave wordpress/wp-content/languages empty.
/wp-translation-downloader.lock

# Secrets
.env
.env.*
!.env.example

# Database dumps hold personal data
*.sql
*.sql.gz

# OS / editor / tooling noise
.DS_Store
*.swp
node_modules/
